{
  "name": "futstats",
  "version": "0.1.0",
  "private": true,
  "description": "Base de datos y análisis de futbolistas, ligas, competiciones y rendimiento.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @futstats/db",
    "db:migrate": "npm run migrate -w @futstats/db",
    "db:deploy": "npm run deploy -w @futstats/db",
    "db:push": "npm run push -w @futstats/db",
    "db:validate": "npm run validate -w @futstats/db"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
