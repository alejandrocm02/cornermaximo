{
  "name": "cornermaximo",
  "version": "0.1.0",
  "private": true,
  "description": "Base de datos y análisis de futbolistas, ligas, competiciones y rendimiento.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @cornermaximo/db",
    "db:migrate": "npm run migrate -w @cornermaximo/db",
    "db:deploy": "npm run deploy -w @cornermaximo/db",
    "db:push": "npm run push -w @cornermaximo/db",
    "db:validate": "npm run validate -w @cornermaximo/db"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
