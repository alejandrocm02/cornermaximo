{
  "name": "futstats",
  "version": "0.1.0",
  "private": true,
  "description": "Base de datos y análisis de futbolistas — últimos 5 partidos. 5 grandes ligas europeas.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @futstats/db",
    "db:migrate": "npm run migrate -w @futstats/db",
    "db:validate": "npm run validate -w @futstats/db"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
