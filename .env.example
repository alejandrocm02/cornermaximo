# --- Base de datos (Neon free tier o Postgres local con docker-compose) ---
DATABASE_URL="postgresql://futstats:futstats@localhost:5432/futstats"

# --- API-Football (plan Pro: 19 $/mes, 7 500 requests/día, 300 req/min) ---
# Regístrate en https://www.api-football.com y copia tu clave.
# NUNCA exponer en el frontend. Solo se usa en servidor.
API_FOOTBALL_KEY=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_DAILY_LIMIT="7500"
# Separación mínima entre requests en ms (300 req/min del plan Pro => 200ms de sobra).
API_FOOTBALL_MIN_INTERVAL_MS="200"

# --- Redis / caché (Upstash free tier u omitir en desarrollo) ---
REDIS_URL=""

# --- Seguridad de los endpoints de sincronización ---
# GitHub Actions llamará a los endpoints /api/admin/sync/* con esta clave.
SYNC_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"

# Nota: las competiciones y temporadas a sincronizar (5 grandes ligas en
# 2025-26 y 2026-27, más el Mundial 2026) están fijadas en código
# (packages/shared: TRACKED_COMPETITIONS), no en variables de entorno.

# --- URL pública de la app (en local: http://localhost:3000) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
